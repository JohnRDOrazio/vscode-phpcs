{
	"compilerOptions": {
		// Explicit rather than inherited: TypeScript 5 defaults strict to false
		// and TypeScript 7 defaults it to true, so a bare compiler upgrade would
		// silently turn it on here. The client has 41 strict findings — the same
		// 41 under 5.9.3 and 7.0.2, so pre-existing debt rather than anything the
		// upgrade introduced. Tracked in #78; sibling phpcs-server already sets
		// this to true.
		"strict": false,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitAny": true,
		"noImplicitReturns": true,
		"target": "ES2022",
		"module": "node16",
		"moduleResolution": "node16",
		"sourceMap": true,
		"lib": [ "ES2022" ],
		"rootDir": ".",
		"outDir": "out",
		"skipLibCheck": true,
		// Ambient type packages are named explicitly rather than left to
		// whatever happens to be in node_modules. TypeScript 5 auto-includes
		// every @types/* it can walk up to; TypeScript 7 does not, and without
		// this the mocha TDD globals (suite/test/setup/teardown) go undefined.
		"types": ["node", "mocha", "vscode"]
	},
	"exclude": [
		"node_modules",
		"server"
	]
}
