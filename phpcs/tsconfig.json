{
	"compilerOptions": {
		// Matches phpcs-server. Reached in stages through #78: the resolvers, then
		// configuration.ts, then the lazily-initialised fields this last flag
		// covers. Explicit rather than inherited, because TypeScript 5 defaults
		// it to false and 7 defaults it to true.
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitAny": true,
		"noImplicitReturns": true,
		"target": "ES2022",
		"module": "node16",
		"moduleResolution": "node16",
		"sourceMap": true,
		"lib": [ "ES2022" ],
		"rootDir": ".",
		"outDir": "out",
		"skipLibCheck": true,
		// Ambient type packages are named explicitly rather than left to
		// whatever happens to be in node_modules. TypeScript 5 auto-includes
		// every @types/* it can walk up to; TypeScript 7 does not, and without
		// this the mocha TDD globals (suite/test/setup/teardown) go undefined.
		"types": ["node", "mocha", "vscode"]
	},
	"exclude": [
		"node_modules"
	]
}
