{
  "name": "vscode-phpcs",
  "description": "PHP CodeSniffer for Visual Studio Code",
  "version": "1.3.0",
  "author": "Ioannis Kappas",
  "publisher": "johnrdorazio",
  "contributors": [
    {
      "email": "sheva@shevaua.info",
      "name": "Igor Sheviakov"
    },
    {
      "email": "priest@johnromanodorazio.com",
      "name": "John R. D'Orazio"
    }
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JohnRDOrazio/vscode-phpcs.git"
  },
  "scripts": {
    "test": "npm-run-all --parallel test:*",
    "test:server": "cd phpcs-server && npm test",
    "test:server:unit": "cd phpcs-server && npm run test:unit",
    "test:server:integration": "cd phpcs-server && npm run test:integration",
    "test:server:coverage": "cd phpcs-server && npm run test:coverage",
    "test:client": "cd phpcs && npm test",
    "postinstall": "npm-run-all --parallel postinstall:*",
    "postinstall:server": "cd phpcs-server && npm install",
    "postinstall:client": "cd phpcs && npm install",
    "compile": "npm-run-all --serial clean:* compile:*",
    "compile:server": "tsc -p phpcs-server/tsconfig.json",
    "compile:client": "tsc -p phpcs/tsconfig.json",
    "watch:server": "tsc -w -p phpcs-server/tsconfig.json",
    "watch:client": "tsc -w -p phpcs/tsconfig.json",
    "bundle": "npm-run-all --serial clean:dist esbuild:server esbuild:client",
    "bundle-dev": "npm-run-all --serial clean:dist esbuild-dev:server esbuild-dev:client",
    "bundle-watch": "npm-run-all --parallel esbuild-watch:server esbuild-watch:client",
    "esbuild:server": "cd phpcs-server && node esbuild.js --production",
    "esbuild:client": "cd phpcs && node esbuild.js --production",
    "esbuild-dev:server": "cd phpcs-server && node esbuild.js",
    "esbuild-dev:client": "cd phpcs && node esbuild.js",
    "esbuild-watch:server": "cd phpcs-server && node esbuild.js --watch",
    "esbuild-watch:client": "cd phpcs && node esbuild.js --watch",
    "clean": "npm-run-all --parallel clean:*",
    "clean:server": "cd phpcs-server && npm run clean",
    "clean:client": "cd phpcs && npm run clean",
    "clean:dist": "rimraf phpcs/dist",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#**/node_modules\" \"#.yarn\"",
    "lint:md:fix": "markdownlint-cli2 --fix \"**/*.md\" \"#**/node_modules\" \"#.yarn\"",
    "format:md": "prettier --write \"**/*.md\" \"!**/node_modules/**\"",
    "typecheck": "tsc -p phpcs-server/tsconfig.json --noEmit && tsc -p phpcs/tsconfig.json --noEmit",
    "lint-staged": "lint-staged",
    "package": "cd phpcs && vsce package",
    "package-dev": "npm-run-all --serial bundle-dev package",
    "package-prod": "npm-run-all --serial bundle package",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22.22.1"
  },
  "lint-staged": {
    "*.md": "markdownlint-cli2"
  },
  "overrides": {
    "serialize-javascript": "^7.0.7"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/micromatch": "^4.0.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.1",
    "@types/semver": "^7.8.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "markdownlint-cli2": "^0.23.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  }
}
