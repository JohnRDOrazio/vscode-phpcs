{
	"compilerOptions": {
		// Explicit rather than inherited: TypeScript 5 defaults strict to false
		// and TypeScript 7 defaults it to true. This project passes strict under
		// both, so it says so and keeps it.
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitAny": true,
		"noImplicitReturns": true,
		"target": "ES2022",
		"module": "node16",
		"moduleResolution": "node16",
		"sourceMap": true,
		"lib": [ "ES2022" ],
		"outDir": "../phpcs/server",
		"skipLibCheck": true,
		// Ambient type packages are named explicitly rather than left to
		// whatever happens to be in node_modules. TypeScript 5 auto-includes
		// every @types/* it can walk up to; TypeScript 7 does not, and without
		// this the mocha TDD globals (suite/test/setup/teardown) go undefined.
		"types": ["node", "mocha"]
	},
	"exclude": [
		"node_modules"
	]
}
